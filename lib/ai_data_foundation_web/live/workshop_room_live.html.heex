<Layouts.app flash={@flash}>
  <section class="workshop-hero">
    <div class="workshop-container">
      <a class="workshop-back" href={~p"/workshops/#{@track["id"]}"}>&larr; Workshop guide</a>
      <p class="workshop-eyebrow">Live workshop room</p><h1>{@track["title"]}</h1>
      <p class="workshop-lede">
        Learn together. Share a notebook, compare progress, and ask for help.
      </p>
    </div>
  </section>
  <div class="workshop-container workshop-section" id="workshop-room">
    <p :if={@error} role="alert" id="room-error" class="workshop-result">{@error}</p>
    <div class="workshop-panel">
      <h2 class="text-2xl font-bold mb-4">Invite your group</h2>
      <p>
        Share this room link with participants. Anyone with the link can join using a display name. Names and progress are temporary and disappear after disconnecting.
      </p>
      <label class="block mt-4" for="room-link">Room link</label>
      <input id="room-link" class="room-input" value={@share_url} readonly aria-label="Room link" />
    </div>
    <div class="workshop-grid room-grid">
      <section class="workshop-panel" aria-labelledby="your-session">
        <h2 id="your-session" class="text-xl font-bold mb-4">Your session</h2>
        <.form :if={not @joined?} for={@join_form} id="join-room" phx-submit="join">
          <.input field={@join_form[:name]} label="Display name" maxlength="40" required />
          <button id="join-room-button" class="kube-button mt-4">Join room</button>
        </.form>
        <div :if={@joined?} id="room-controls">
          <p class="mb-4">Joined as <strong>{@name}</strong>. Progress is self reported.</p>
          <button
            :for={{step, index} <- Enum.with_index(@track["steps"], 1)}
            id={"room-step-#{index}"}
            type="button"
            phx-click="toggle_step"
            phx-value-step={index}
            aria-pressed={to_string(index in @completed)}
            class="room-step"
          >
            {if index in @completed, do: "✓", else: "○"} {step["title"]}
          </button>
          <button
            id="room-help"
            type="button"
            phx-click="toggle_help"
            aria-pressed={to_string(@help?)}
            class="kube-button kube-button-outline mt-4"
          >{if @help?, do: "Help request resolved", else: "Raise hand for help"}</button>
        </div>
      </section>
      <section class="workshop-panel" aria-labelledby="room-participants-title">
        <h2 id="room-participants-title" class="text-xl font-bold mb-4">
          Participants ({@participant_count})
        </h2>
        <ul id="room-participants" phx-update="stream">
          <li id="room-participants-empty" class="hidden only:block">
            Join the room to appear here.
          </li>
          <li :for={{dom_id, person} <- @streams.participants} id={dom_id} class="room-person">
            <strong>{person.name}</strong><span>{length(person.completed)} / {length(
              @track["steps"]
            )} labs</span>
            <span :if={person.help?} class="workshop-badge">Needs help</span>
            <button
              :if={person.session_url}
              type="button"
              phx-click="show_notebook"
              phx-value-participant={person.id}
              class="room-step"
            >Open {person.name}'s shared notebook</button>
          </li>
        </ul>
      </section>
    </div>
    <section class="workshop-panel">
      <h2 class="text-2xl font-bold mb-4">Collaborate in Livebook</h2>
      <p>
        One participant opens the workshop notebook in a shared Livebook server, then shares its session URL below. Everyone opens that same session to edit together. Opening separate imports creates separate notebooks.
      </p>
      <div class="workshop-step-links">
        <a href={WorkshopNotebooks.launch_url(@track["id"])} target="_blank" rel="noopener">Open workshop in Livebook &nearr;</a><a
          href={WorkshopNotebooks.download_url(@track["id"])}
          download
        >Download notebook</a>
      </div>
      <p :if={is_nil(Application.get_env(:ai_data_foundation, :livebook_url))}>
        A shared Livebook server has not been configured. You can use the launch button for your own instance; sharing a notebook inside this room becomes available when the operator connects Livebook.
      </p>
      <.form
        :if={@joined? and Application.get_env(:ai_data_foundation, :livebook_url)}
        for={@notebook_form}
        id="share-notebook"
        phx-submit="share_notebook"
      >
        <.input
          field={@notebook_form[:url]}
          type="url"
          label="Shared Livebook session URL"
          placeholder="https://your-livebook-server/sessions/session-id"
          required
        />
        <button class="kube-button mt-4">Share notebook with room</button>
      </.form>
      <p :if={@track["id"] == "mlx"} class="workshop-result">
        MLX requires the notebook runtime to run on an Apple silicon Mac. Your browser's hardware does not determine the remote runtime's hardware.
      </p>
    </section>
    <section :if={@active_notebook} class="workshop-panel" id="shared-notebook">
      <div class="workshop-section-heading">
        <h2 class="text-xl font-bold">Shared notebook</h2><button
          type="button"
          phx-click="close_notebook"
          class="room-step"
        >Close notebook</button>
      </div>
      <p class="mb-4">
        Sign in to Livebook with your workshop credentials. If embedding is unavailable, <a
          href={@active_notebook}
          target="_blank"
          rel="noopener"
          class="underline"
        >open this session in a new tab</a>.
      </p>
      <iframe
        id="livebook-session"
        title="Collaborative Livebook notebook"
        src={@active_notebook}
        class="room-notebook"
        referrerpolicy="no-referrer"
        allow="clipboard-write"
      />
    </section>
  </div>
</Layouts.app>
