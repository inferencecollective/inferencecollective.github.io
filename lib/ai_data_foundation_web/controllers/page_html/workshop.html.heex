<div class="workshop-reader" data-workshop={@track["id"]}>
  <section class="workshop-hero">
    <div class="workshop-container">
      <a class="workshop-back" href="/workshops">&larr; Workshop tracks</a>
      <p class="workshop-eyebrow">
        {@track["level"]} / ~{@track["minutes"]} minutes / {@track["hardware"] || "CPU"}
      </p>
      <h1>{@track["title"]}</h1><p class="workshop-lede">{@track["description"]}</p>
      <div class="workshop-facts">
        <span>Python 3.11–3.13</span><span>{if @track["platform"] == "apple-silicon",
          do: "Apple silicon Mac · macOS 14+",
          else: "No GPU required"}</span><span>No API keys</span>
      </div>
    </div>
  </section>
  <div class="workshop-container workshop-layout">
    <aside class="workshop-sidebar" aria-label="Workshop navigation">
      <p class="workshop-eyebrow">Your workshop</p><a href={
        if @track["id"] == "mlx", do: "#mlx-notebook-launch", else: "#livebook-launch"
      }>Launch interactive notebook</a><a href="#setup">00 / Set up your environment</a>
      <a :for={{step, index} <- Enum.with_index(@track["steps"], 1)} href={"#step-#{index}"}>0{index} / {step[
        "title"
      ]}</a>
      <a href="#finish">Finish / Show your work</a>
      <div data-workshop-progress hidden>
        <label for="workshop-progress">Your progress</label><progress
          id="workshop-progress"
          value="0"
          max={length(@track["steps"])}
        ></progress><p data-workshop-count role="status" aria-live="polite"></p><small>Saved on this browser when storage is available.</small>
      </div>
    </aside>
    <div class="workshop-main kube-markdown">
      <section :if={@track["id"] == "mlx"} id="mlx-notebook-launch" class="workshop-panel">
        <p class="workshop-eyebrow">Recommended / MLX notebook</p><h2>
          Train, predict, and measure in mlx.ipynb
        </h2>
        <p>
          A self-contained workshop for your Mac: learn autograd, save a model, run inference, and compare compiled execution with plots and reproducible reports.
        </p>
        <div class="workshop-step-links">
          <a
            id="download-mlx-ipynb"
            class="kube-button"
            href="/aidatafoundation/notebooks/mlx.ipynb"
            download="mlx.ipynb"
          >Download mlx.ipynb &darr;</a>
          <a
            href="https://github.com/inferencecollective/inferencecollective.github.io/blob/main/priv/static/aidatafoundation/notebooks/mlx.ipynb"
            target="_blank"
            rel="noopener"
          >Preview on GitHub &nearr;</a>
        </div>
        <p>
          Open the notebook in VS Code or Jupyter with a native arm64 Python kernel on Apple silicon. Install its environment from the repository:
        </p>
        <pre><code>python -m pip install -r requirements/workshops/mlx-notebook.txt</code></pre>
        <p>
          Select that environment as your kernel, restart, and Run All. It uses synthetic data and needs no model downloads or API keys. Use Livebook below when you want a shared editing session.
        </p>
      </section>
      <section id="livebook-launch" class="workshop-panel">
        <p class="workshop-eyebrow">Interactive notebook</p><h2>
          {if @track["id"] == "mlx",
            do: "Collaborate with Livebook",
            else: "Open this workshop in Livebook"}
        </h2>
        <p>
          Run the exercises in a notebook with Python cells, explanations, and outputs. Use your own Livebook instance, or join your group's shared server.
        </p>
        <div class="workshop-step-links">
          <a
            id="launch-livebook"
            class="kube-button"
            href={WorkshopNotebooks.launch_url(@track["id"])}
            target="_blank"
            rel="noopener"
          >Open in Livebook &nearr;</a>
          <a id="download-livebook" href={WorkshopNotebooks.download_url(@track["id"])} download>Download .livemd notebook</a>
          <a
            :if={WorkshopNotebooks.room_url(@track["id"])}
            id="join-live-room"
            class="kube-button kube-button-outline"
            href={WorkshopNotebooks.room_url(@track["id"])}
          >Start a live workshop room &rarr;</a>
        </div>
        <p :if={is_nil(WorkshopNotebooks.room_url(@track["id"]))}>
          Live workshop rooms are not enabled on this site yet. You can still open or download the notebook.
        </p>
        <p :if={@track["id"] == "mlx"} class="workshop-result">
          For MLX, run Livebook on Apple silicon with macOS 14+. A cloud Linux notebook cannot use your Mac's Metal GPU.
        </p>
      </section>
      <section id="setup" class="workshop-panel">
        <p class="workshop-eyebrow">00 / Get ready</p><h2>Set up your environment</h2>
        <p>
          <strong>What you need:</strong> {@track["prerequisites"]} Install Git and Python 3.11–3.13 before starting. All commands below run on your machine; the website does not execute Python.
        </p>
        <h3>1. Get the code</h3><pre><code>{"git clone https://github.com/inferencecollective/inferencecollective.github.io.git\ncd inferencecollective.github.io"}</code></pre>
        <h3>2. Create an isolated environment</h3>
        <details open>
          <summary>
            {if @track["platform"] == "apple-silicon",
              do: "macOS · native arm64 Python",
              else: "macOS / Linux"}
          </summary><pre><code>{"python3 -m venv .venv\nsource .venv/bin/activate\npython -m pip install --upgrade pip\npython -m pip install -r requirements/workshops/#{@track["id"]}.txt"}</code></pre>
        </details>
        <details :if={@track["platform"] != "apple-silicon"}>
          <summary>Windows PowerShell</summary><pre><code>{"py -3.12 -m venv .venv\n.venv\\Scripts\\python.exe -m pip install --upgrade pip\n.venv\\Scripts\\python.exe -m pip install -r requirements/workshops/#{@track["id"]}.txt"}</code></pre><p>
            Use <code>.venv\Scripts\python.exe</code>
            in place of <code>python</code>
            in every command below. Activation is optional.
          </p>
        </details>
        <div
          :if={@track["platform"] == "apple-silicon"}
          class="workshop-result"
          id="mlx-device-setup"
        >
          <strong>Choose your MLX device</strong>
          <p>
            The default selects Metal GPU when available, otherwise CPU. Check or run a specific device with:
          </p>
          <pre><code>python -m labs.workshop mlx --check --device gpu
python -m labs.workshop mlx --device cpu</code></pre>
          <p>
            Use native arm64 Python. If the Metal check fails, try CPU. Other platforms can follow the ML foundations, PyTorch, and vision tracks.
          </p>
        </div>
        <h3>3. Check your setup</h3><pre><code>{"python -m labs.workshop #{@track["id"]} --check"}</code></pre>
        <p>
          Run these commands from the repository root. The check reports missing packages before you start. Each lab uses included sample data; no accounts or downloaded models are needed.
        </p>
        <details>
          <summary>Stuck on setup?</summary><ul>
            <li>
              <strong>No matching package distribution:</strong>
              check <code>python --version</code>
              and recreate the environment with Python 3.11–3.13.
            </li><li>
              <strong>No module named labs:</strong>
              change into the cloned repository and use <code>python -m</code>
              rather than running the file directly.
            </li><li>
              <strong>Missing dependency:</strong>
              install the track requirements with the same Python interpreter you use to run the lab.
            </li><li>
              <strong>Plot window does not appear:</strong>
              open the saved PNG in <code>outputs/</code>. Workshop runs use a noninteractive plotting backend.
            </li>
          </ul>
        </details>
      </section>
      <section
        :for={{step, index} <- Enum.with_index(@track["steps"], 1)}
        id={"step-#{index}"}
        class="workshop-panel"
      >
        <p class="workshop-eyebrow">0{index} / ~{step["minutes"]} minutes</p><h2>
          {step["title"]}
        </h2>
        <div class="workshop-step-links">
          <a href={~p"/labs/#{step["guide"]}"}>Read the full guide &rarr;</a><a href={"https://github.com/inferencecollective/inferencecollective.github.io/blob/main/#{String.replace(step["module"], ".", "/")}.py"}>Inspect source &nearr;</a>
        </div>
        <h3>Run the lab</h3><pre><code>{"python -m labs.workshop #{@track["id"]} --step #{index}"}</code></pre>
        <div class="workshop-result">
          <strong>What you should see</strong><p>{step["outcome"]}</p>
        </div>
        <h3>Make a change</h3><p>{step["challenge"]}</p>
        <label class="workshop-complete" data-workshop-control hidden><input
          type="checkbox"
          data-workshop-step={index}
        /> I ran the lab, inspected the output, and tried the exercise</label>
        <a
          class="workshop-next"
          href={if index < length(@track["steps"]), do: "#step-#{index + 1}", else: "#finish"}
        >Next step &darr;</a>
      </section>
      <section id="finish" class="workshop-panel">
        <p class="workshop-eyebrow">Finish / Show your work</p><h2>
          Turn the run into understanding.
        </h2><p>
          Share one output, the parameter you changed, and what you learned. Keep the source change and output together so a teammate can reproduce your result.
        </p><p>To rerun the whole track:</p><pre><code>{"python -m labs.workshop #{@track["id"]}"}</code></pre><a
          class="kube-button"
          href="/workshops"
        >Choose your next track &rarr;</a><p>
          Continue exploring in the <a href="/labs">complete lab library</a>.
        </p>
      </section>
    </div>
  </div>
</div>
