<%!-- Next Useful Steps Section --%>
<section id="next-steps" class="border-t border-slate-800 bg-[#070A0F] py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="kube-home-section-heading mb-8">
      <div>
        <span class="kube-kicker">Next Useful Steps</span>
        <h2 class="text-3xl font-black tracking-tight text-white mt-1">
          Continue Your Security Journey
        </h2>
