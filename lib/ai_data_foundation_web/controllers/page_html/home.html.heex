<%!-- AI Data Foundation Home Hero --%>
<section id="home-intro" class="kube-home-hero" aria-labelledby="home-title">
  <div class="kube-hero-container">
    <div class="kube-hero-grid">
      <div class="lg:col-span-7 kube-home-copy">
        <span class="kube-kicker">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 mr-1"></span>
          Open source. Hands on. For every ML engineer.
        </span>
        <h1 id="home-title">
          Build your skills. <span>Run the code.</span>
        </h1>
        <p>
          Go from Python fundamentals to working ML systems with guided workshop tracks, runnable labs, and practical engineering notes. Start on your CPU with included datasets and no API keys.
        </p>
        <div class="kube-hero-actions">
          <a href="/workshops" class="kube-button">
            Start a workshop &rarr;
          </a>
          <a href="/tools" class="kube-button kube-button-outline">
            Discover AI tools
          </a>
        </div>
        <div class="kube-home-proof">
          <div>
            <strong>62</strong>
            <span>Hosted Projects</span>
          </div>
          <div>
            <strong>4.4M+</strong>
            <span>GitHub Stars</span>
          </div>
          <div>
            <strong>150K+</strong>
            <span>Contributors</span>
          </div>
          <div>
            <strong>500+</strong>
            <span>Landscape Tools</span>
          </div>
        </div>
      </div>

      <%!-- AI Data Foundation Ecosystem Map Sidecard --%>
      <div class="lg:col-span-5">
        <div class="kube-home-map">
          <div class="kube-home-map-top">
            <span>AI Architecture</span>
            <span class="text-emerald-300">Learning navigator</span>
          </div>
          <div class="kube-home-map-content">
            <span class="kube-kicker">Your next step</span>
            <h2>Build with confidence.</h2>
            <ol>
              <li>
                <span>01</span>
                <a href="/labs"><strong>Practice in the labs</strong><small>LangChain, vector databases &amp; RAG</small></a>
              </li>
              <li>
                <span>02</span>
                <a href="/tools"><strong>Find the right tool</strong><small>Explore the open-source ecosystem</small></a>
              </li>
              <li>
                <span>03</span>
                <a href="/models"><strong>Choose your model</strong><small>Benchmarks, context &amp; GPU memory</small></a>
              </li>
              <li>
                <span>04</span>
                <a href="/workshops"><strong>Follow a workshop track</strong><small>Setup, run, inspect, and extend</small></a>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<nav class="kube-home-jumpnav" aria-label="On this page">
  <span>Explore</span>
  <a href="#learning-tracks">Learning tracks</a>
  <a href="#projects">Projects</a>
  <a href="#featured-labs">Labs</a>
  <a href="#research">Research</a>
  <a href="#model-benchmarks">Models</a>
  <a href="#ai-security">Security</a>
</nav>

<%!-- Secure AI Learning Tracks Section --%>
<section id="learning-tracks" class="kube-start-section">
  <div class="kube-section-container">
    <div class="kube-home-section-heading">
      <div>
        <span class="kube-kicker">Core Pillars</span>
        <h2>Secure AI Learning Tracks</h2>
      </div>
      <p>
        From your first local embedding model to production-tested multi-agent workflows, each track is crafted with reproducible code and verified dependencies.
      </p>
    </div>

    <div class="kube-learning-grid">
      <a href="/labs" class="kube-learning-card">
        <span class="kube-learning-step">Track 01 &middot; Practice</span>
        <h3>Security Labs</h3>
        <p>
          Step-by-step technical guides with complete terminal instructions, code blocks, and verification commands.
        </p>
        <span class="kube-learning-action">Browse all labs &rarr;</span>
      </a>

      <a href="/tools" class="kube-learning-card">
        <span class="kube-learning-step">Track 02 &middot; Directory</span>
        <h3>AI Security Tools Index</h3>
        <p>
          Instant search and filter across 500+ curated AI tools, MCP servers, vector databases, and evaluation frameworks.
        </p>
        <span class="kube-learning-action">Search directory &rarr;</span>
      </a>

      <a href="/models" class="kube-learning-card">
        <span class="kube-learning-step">Track 03 &middot; LLM Explorer</span>
        <h3>Models &amp; VRAM Calculator</h3>
        <p>
          Interactive GPU memory sizing tool, context length boundaries, MMLU benchmarks, and curated AI agent frameworks.
        </p>
        <span class="kube-learning-action">Launch LLM Explorer &rarr;</span>
      </a>

      <a href="/roadmap" class="kube-learning-card">
        <span class="kube-learning-step">Track 04 &middot; Curriculum</span>
        <h3>1,000-Item Roadmap</h3>
        <p>
          Comprehensive engineering syllabus covering foundational math, LLM architecture, agentic orchestration, and MLOps.
        </p>
        <span class="kube-learning-action">Follow roadmap &rarr;</span>
      </a>
    </div>

    <%!-- Quick Tool Search Box --%>
    <div class="kube-home-search">
      <form id="home-tool-search" action="/tools" method="get" role="search">
        <label for="home-search-input">Search open AI tools &amp; frameworks</label>
        <div>
          <input
            id="home-search-input"
            name="q"
            type="search"
            placeholder="Try LangChain, Ollama or MCP"
            autocomplete="off"
          />
          <button type="submit" class="kube-button">
            Search Directory
          </button>
        </div>
        <p>Filter by name, description, or category with instant real-time results.</p>
      </form>
    </div>
  </div>
</section>

<%!-- LF AI & Data Foundation Hosted Projects Showcase (CNCF Style) --%>
<section id="projects" class="border-t border-slate-800/80 bg-[#070A0F] py-20 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-3">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          LF AI &amp; Data Foundation Projects
        </span>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-white">
          Neutral, Open-Source AI Infrastructure
        </h2>
        <p class="mt-3 text-base text-slate-300 leading-relaxed">
          The foundation hosts 62 open-source technologies across machine learning, vector databases, model interoperability, and AI safety — with 4.4M+ GitHub stars and 150K+ contributors.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a href="/tools" class="kube-button">
          Browse All 62 Projects &rarr;
        </a>
        <a
          href="https://lfai.landscape2.io"
          target="_blank"
          rel="noopener noreferrer"
          class="kube-button kube-button-outline"
        >
          View Landscape2 &nearr;
        </a>
      </div>
    </div>

    <%!-- LF AI & Data Stack Architecture Diagram rendered by Pele --%>
    <div class="mb-12 p-6 sm:p-8 rounded-2xl border border-slate-800 bg-slate-900/90 shadow-xs">
      <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-800 text-xs">
        <span class="font-bold text-white">LF AI &amp; Data Foundation Architecture Stack</span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 font-mono text-[11px] font-semibold">
          ⚡ Powered by Pele (Mermaid)
        </span>
      </div>
      <div class="mermaid">
        flowchart LR
        subgraph Data["01 Data & Vector Layer"]
        Docling["Docling"]
        Milvus[("Milvus Vector DB")]
        Feast["Feast Feature Store"]
        end
        subgraph Models["02 Models & Formats"]
        ONNX["ONNX Standard"]
        Ludwig["Ludwig LLM"]
        end
        subgraph Agents["03 Orchestration"]
        Flyte["Flyte Pipelines"]
        BeeAI["BeeAI Agents"]
        end
        subgraph Safety["04 Trust & Security"]
        ART["ART Prompt Defense"]
        OpenLineage["OpenLineage Tracking"]
        end
        Data --> Models
        Models --> Agents
        Agents --> Safety
      </div>
    </div>

    <%!-- Tier Overview Ribbon --%>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <div class="p-6 rounded-2xl border border-emerald-800/50 bg-emerald-950/20">
        <div class="flex items-center justify-between mb-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Graduated Stage
          </span>
          <strong class="text-2xl font-black text-emerald-400">13 Projects</strong>
        </div>
        <p class="text-xs text-slate-300 mt-2">
          Mature, production-proven technologies with multi-organization governance, rigorous security reviews, and widespread global adoption.
        </p>
        <div class="mt-4 flex flex-wrap gap-1.5">
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-900 border border-emerald-800 text-slate-300">Milvus</span>
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-900 border border-emerald-800 text-slate-300">ONNX</span>
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-900 border border-emerald-800 text-slate-300">Docling</span>
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-900 border border-emerald-800 text-slate-300">Flyte</span>
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-900 border border-emerald-800 text-slate-300">ART</span>
        </div>
      </div>

      <div class="p-6 rounded-2xl border border-sky-800/50 bg-sky-950/20">
        <div class="flex items-center justify-between mb-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-sky-500/20 text-sky-300">
            <span class="w-2 h-2 rounded-full bg-sky-500"></span> Incubating Stage
          </span>
          <strong class="text-2xl font-black text-sky-400">22 Projects</strong>
        </div>
        <p class="text-xs text-slate-300 mt-2">
          Rapidly growing projects with proven production track records, thriving maintainer ecosystems, and active development cycles.
        </p>
        <div class="mt-4 flex flex-wrap gap-1.5">
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-900 border border-sky-800 text-slate-300">Ludwig</span>
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-900 border border-sky-800 text-slate-300">Delta Lake</span>
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-900 border border-sky-800 text-slate-300">Feast</span>
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-900 border border-sky-800 text-slate-300">FATE</span>
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-900 border border-sky-800 text-slate-300">BeeAI</span>
        </div>
      </div>

      <div class="p-6 rounded-2xl border border-amber-800/50 bg-amber-950/20">
        <div class="flex items-center justify-between mb-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span> Sandbox Stage
          </span>
          <strong class="text-2xl font-black text-amber-400">22 Projects</strong>
        </div>
        <p class="text-xs text-slate-300 mt-2">
          Early-stage innovations fostering community growth, experimental architectures, and pioneering new frontiers in AI &amp; data engineering.
        </p>
        <div class="mt-4 flex flex-wrap gap-1.5">
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-900 border border-amber-800 text-slate-300">Unity Catalog</span>
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-900 border border-amber-800 text-slate-300">Recommenders</span>
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-900 border border-amber-800 text-slate-300">IREE</span>
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-900 border border-amber-800 text-slate-300">LakeSoul</span>
        </div>
      </div>
    </div>

    <%!-- Featured Projects Grid --%>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <%= for proj <- Enum.take(@graduated_projects, 6) ++ Enum.take(@incubating_projects, 3) do %>
        <article class="p-6 rounded-2xl border border-slate-800 bg-slate-900/90 shadow-xs hover:border-emerald-500/50 hover:shadow-lg hover:shadow-emerald-950/20 transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <div class="flex items-center gap-2">
                <%= if proj["maturity"] == "graduated" do %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Graduated
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-sky-500/15 text-sky-400 border border-sky-500/30">
                    <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span> Incubating
                  </span>
                <% end %>
                <span class="text-xs text-slate-400 font-medium">{proj["category"]}</span>
              </div>
              <%= if proj["stars"] > 0 do %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-bold text-amber-400 bg-amber-950/40 border border-amber-800/40 font-mono">
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  {if proj["stars"] >= 1000,
                    do: "#{Float.round(proj["stars"] / 1000, 1)}k",
                    else: proj["stars"]}
                </span>
              <% end %>
            </div>

            <div class="flex items-center gap-3.5 mb-2">
              <%= if proj["logo"] do %>
                <div class="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700/80 p-1.5 flex items-center justify-center shrink-0 shadow-xs">
                  <img
                    src={proj["logo"]}
                    alt={proj["name"]}
                    class="w-full h-full object-contain"
                    loading="lazy"
                    onerror="this.style.display='none'"
                  />
                </div>
              <% end %>
              <div class="min-w-0 flex-1">
                <h3 class="text-xl font-bold text-white group-hover:text-emerald-400 transition-colors">
                  <a
                    href={proj["website"] || proj["repo"]}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {proj["name"]}
                  </a>
                </h3>
                <span class="text-xs text-slate-400 font-mono block">{proj["subcategory"]}</span>
              </div>
            </div>

            <p class="text-sm text-slate-300 mt-2 line-clamp-2 leading-relaxed">
              {proj["description"]}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-800 flex items-center justify-between text-xs">
            <span class="text-slate-400 font-mono">LF AI &amp; Data</span>
            <a
              href={proj["repo"] || proj["website"]}
              target="_blank"
              rel="noopener noreferrer"
              class="font-bold text-emerald-400 hover:underline inline-flex items-center gap-1"
            >
              GitHub Repo &rarr;
            </a>
          </div>
        </article>
      <% end %>
    </div>

    <div class="mt-12 text-center">
      <a href="/tools" class="kube-button">
        Explore All 62 Projects &amp; Landscape Directory &rarr;
      </a>
    </div>
  </div>
</section>

<%!-- Featured Labs Section --%>
<section id="featured-labs" class="max-w-7xl mx-auto px-4 py-16 sm:px-6 lg:px-8">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
    <div>
      <span class="kube-kicker">Interactive Workshops</span>
      <h2 class="text-3xl font-black tracking-tight text-white mt-1">
        Featured Security Labs
      </h2>
    </div>
    <a
      href="/labs"
      class="text-sm font-bold text-emerald-400 hover:underline"
    >
      Browse the lab library &rarr;
    </a>
  </div>

  <div class="kube-labs-grid">
    <%= for lab <- @featured_labs do %>
      <article class="kube-lab-card glass-card">
        <div class="kube-lab-card-meta">
          <span class="kube-label">{lab["category"]}</span>
          <span class="text-xs font-mono text-slate-400">&gt;_ terminal</span>
        </div>
        <h3 class="text-xl font-bold mt-3 mb-2 text-white">
          <a href={~p"/labs/#{lab["id"]}"} class="hover:text-emerald-400 transition">
            {lab["title"]}
          </a>
        </h3>
        <p class="text-sm text-slate-300 leading-relaxed mb-4 flex-1">
          {lab["description"]}
        </p>
        <div class="kube-tag-list mb-4">
          <%= for tag <- Enum.take(lab["tags"] || [], 3) do %>
            <span class="kube-tag">{tag}</span>
          <% end %>
        </div>
        <div class="kube-lab-card-footer pt-4 border-t border-slate-800 flex items-center justify-between">
          <span class="text-xs text-slate-400">By {Enum.join(
            lab["contributors"] || ["ADF"],
            ", "
          )}</span>
          <a
            href={~p"/labs/#{lab["id"]}"}
            class="text-sm font-bold text-emerald-400 hover:underline"
          >
            Open Lab &rarr;
          </a>
        </div>
      </article>
    <% end %>
  </div>
</section>

<%!-- Latest Blog Articles --%>
<section id="research" class="border-t border-slate-800 bg-[#0B0F17]/70 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <span class="kube-kicker">Engineering Journal</span>
        <h2 class="text-3xl font-black tracking-tight text-white mt-1">
          Latest Research &amp; Architectural Notes
        </h2>
      </div>
      <a
        href="/blog"
        class="text-sm font-bold text-emerald-400 hover:underline"
      >
        View all articles &rarr;
      </a>
    </div>

    <div class="kube-blog-grid">
      <%= for post <- @featured_posts do %>
        <article class="kube-blog-card glass-card">
          <div class="kube-lab-card-meta">
            <span class="kube-label">{post["category"]}</span>
            <span class="text-xs text-slate-400">{post["date"]}</span>
          </div>
          <h3 class="text-xl font-bold mt-3 mb-2 text-white">
            <a href={~p"/blog/#{post["id"]}"} class="hover:text-emerald-400 transition">
              {post["title"]}
            </a>
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed mb-4 flex-1">
            {post["description"]}
          </p>
          <div class="pt-4 border-t border-slate-800 flex items-center justify-between">
            <span class="text-xs text-slate-400">By {post["author"]}</span>
            <a
              href={~p"/blog/#{post["id"]}"}
              class="text-sm font-bold text-emerald-400 hover:underline"
            >
              Read Article &rarr;
            </a>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>

<%!-- Model Leaderboard Snapshot --%>
<section id="model-benchmarks" class="max-w-7xl mx-auto px-4 py-16 sm:px-6 lg:px-8">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
    <div>
      <span class="kube-kicker">Open Weights</span>
      <h2 class="text-3xl font-black tracking-tight text-white mt-1">
        Open Weight Model Benchmarks
      </h2>
    </div>
    <a
      href="/models"
      class="text-sm font-bold text-emerald-400 hover:underline inline-flex items-center gap-1"
    >
      Full leaderboard &amp; VRAM Calculator &rarr;
    </a>
  </div>

  <div
    class="kube-home-model-scroll overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900/90 shadow-xs"
    role="region"
    aria-label="Open model benchmark comparison, scroll horizontally for more columns"
    tabindex="0"
  >
    <table class="w-full text-left text-sm">
      <caption class="sr-only">Open weight model benchmarks</caption>
      <thead class="bg-slate-950/60 border-b border-slate-800 text-xs font-bold uppercase tracking-wider text-slate-400">
        <tr>
          <th class="py-3.5 px-4">Model</th>
          <th class="py-3.5 px-4">Maintainer</th>
          <th class="py-3.5 px-4">Parameters</th>
          <th class="py-3.5 px-4">MMLU Score</th>
          <th class="py-3.5 px-4">Context Length</th>
          <th class="py-3.5 px-4">License</th>
          <th class="py-3.5 px-4">Primary Strength</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60">
        <%= for model <- @featured_models do %>
          <tr class="hover:bg-slate-800/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-white">
              {model["name"]}
            </td>
            <td class="py-3.5 px-4">
              <span class="inline-block py-0.5 px-2 rounded-md bg-slate-800 text-xs font-semibold text-slate-300">
                {model["maintainer"]}
              </span>
            </td>
            <td class="py-3.5 px-4 font-mono text-xs font-semibold text-emerald-400">
              {model["parameters"]}
            </td>
            <td class="py-3.5 px-4">
              <span class="inline-block px-2.5 py-0.5 rounded text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                {model["mmlu"]}%
              </span>
            </td>
            <td class="py-3.5 px-4 font-mono text-xs text-slate-400">
              {model["context"]}
            </td>
            <td class="py-3.5 px-4">
              <span class="text-xs font-medium text-slate-400">
                {model["license"]}
              </span>
            </td>
            <td class="py-3.5 px-4 text-xs text-slate-300 max-w-xs leading-relaxed">
              {model["description"]}
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<%!-- AI Security Focus Section --%>
<section id="ai-security" class="border-t border-slate-800 bg-[#070A0F] py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="kube-home-section-heading">
      <div>
        <span class="kube-kicker">AI Security</span>
        <h2 class="text-3xl font-black tracking-tight text-white mt-1">
          Secure Your AI Systems
        </h2>
      </div>
      <p class="text-slate-300 max-w-2xl">
        From prompt injection defense to model watermarking, red-teaming automation, and regulatory compliance — build AI systems that withstand adversarial threats.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      <div class="kube-learning-card glass-card p-6 border-l-4 border-red-500">
        <div class="w-10 h-10 rounded-lg bg-red-950/60 border border-red-800/40 flex items-center justify-center mb-3">
          <svg
            class="w-5 h-5 text-red-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
          /></svg>
        </div>
        <h3 class="font-bold text-white mb-1">
          Prompt Injection Defense
        </h3>
        <p class="text-sm text-slate-300">
          Detect & block adversarial inputs, jailbreaks, and indirect prompt injections in production LLM apps.
        </p>
      </div>

      <div class="kube-learning-card glass-card p-6 border-l-4 border-amber-500">
        <div class="w-10 h-10 rounded-lg bg-amber-950/60 border border-amber-800/40 flex items-center justify-center mb-3">
          <svg
            class="w-5 h-5 text-amber-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
          /></svg>
        </div>
        <h3 class="font-bold text-white mb-1">
          Model Watermarking
        </h3>
        <p class="text-sm text-slate-300">
          Embed cryptographic provenance into model weights to detect unauthorized distillation and prove ownership.
        </p>
