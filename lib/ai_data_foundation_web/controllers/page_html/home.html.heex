      <div class="kube-learning-card glass-card p-6 border-l-4 border-violet-500">
        <div class="w-10 h-10 rounded-lg bg-violet-950/60 border border-violet-800/40 flex items-center justify-center mb-3">
          <svg
            class="w-5 h-5 text-violet-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
          /></svg>
        </div>
        <h3 class="font-bold text-white mb-1">
          Automated Red-Teaming
        </h3>
        <p class="text-sm text-slate-300">
          Continuous adversarial testing with Garak, PromptFoo, and custom attack strategies in CI/CD pipelines.
        </p>
      </div>

      <div class="kube-learning-card glass-card p-6 border-l-4 border-emerald-500">
        <div class="w-10 h-10 rounded-lg bg-emerald-950/60 border border-emerald-800/40 flex items-center justify-center mb-3">
          <svg
            class="w-5 h-5 text-emerald-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
          /></svg>
        </div>
        <h3 class="font-bold text-white mb-1">
          Data Provenance & Governance
        </h3>
        <p class="text-sm text-slate-300">
          End-to-end data lineage, access controls, and compliance automation for EU AI Act & NIST AI RMF.
        </p>
      </div>
    </div>

    <div class="flex flex-wrap gap-4 justify-center">
