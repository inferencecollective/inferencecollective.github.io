<!-- AI Data Foundation Tools Hero -->
<section class="kube-tools-hero relative overflow-hidden bg-[#070A0F] border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 py-16 sm:py-20 sm:px-6 lg:px-8 relative z-10">
    <div class="kube-tools-hero-copy max-w-4xl">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        LF AI &amp; Data Foundation &middot; 62 Hosted Technologies &middot; 3,780+ Ecosystem Tools &amp; MCP Servers
      </span>
      <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight leading-tight">
        Explore the tools that power
        <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">modern AI systems.</span>
      </h1>
      <p class="mt-5 text-lg text-slate-300 leading-relaxed max-w-3xl">
        Explore the complete open AI landscape — featuring graduated, incubating, and sandbox technologies alongside curated Model Context Protocol (MCP) servers, vector databases, inference runtimes, and adversarial security tools.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="https://github.com/aidatafoundation/aidatafoundation.github.io"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 px-4 py-2.5 rounded-xl border border-slate-700 bg-slate-900/80 hover:bg-slate-800 hover:border-emerald-500/40 text-white transition-all shadow-sm"
        >
          <span class="text-amber-400 font-bold text-lg">&starf;</span>
          <div class="text-left">
            <strong id="kube-github-stars" class="block text-xs font-bold text-slate-200">Star AI Data Foundation on GitHub</strong>
            <small class="text-[11px] text-slate-400">Inference Collective supported &middot; Open source under Apache-2.0</small>
          </div>
        </a>
        <a
          href="https://lfai.landscape2.io"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-700 bg-slate-800/80 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition"
        >
          <span>Official LF AI Landscape2</span>
          <span aria-hidden="true">&nearr;</span>
        </a>
        <a
          href="#kube-tools"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold transition shadow-sm shadow-emerald-500/20"
        >
          <span>Search 3,780+ Tools &darr;</span>
        </a>
      </div>

      <!-- Quick Tiers Summary Bar (Interactive Clickable Filters) -->
      <div class="mt-8 pt-6 border-t border-slate-800/80 grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
        <button
          type="button"
          onclick="window.filterToolsTier && window.filterToolsTier('graduated')"
          class="text-left p-3 rounded-xl border border-slate-800 bg-slate-900/50 hover:border-emerald-500/50 hover:bg-slate-900 transition cursor-pointer group"
        >
          <span class="text-slate-400 block font-medium group-hover:text-emerald-400 transition">Graduated</span>
          <strong class="text-white text-base font-bold">13 Projects</strong>
          <p class="text-[11px] text-emerald-400">Milvus, ONNX, Docling, Flyte</p>
        </button>
        <button
          type="button"
          onclick="window.filterToolsTier && window.filterToolsTier('incubating')"
          class="text-left p-3 rounded-xl border border-slate-800 bg-slate-900/50 hover:border-sky-500/50 hover:bg-slate-900 transition cursor-pointer group"
        >
          <span class="text-slate-400 block font-medium group-hover:text-sky-400 transition">Incubating</span>
          <strong class="text-white text-base font-bold">22 Projects</strong>
          <p class="text-[11px] text-sky-400">Ludwig, Delta Lake, Feast, BeeAI</p>
        </button>
        <button
          type="button"
          onclick="window.filterToolsTier && window.filterToolsTier('sandbox')"
          class="text-left p-3 rounded-xl border border-slate-800 bg-slate-900/50 hover:border-amber-500/50 hover:bg-slate-900 transition cursor-pointer group"
        >
          <span class="text-slate-400 block font-medium group-hover:text-amber-400 transition">Sandbox</span>
          <strong class="text-white text-base font-bold">22 Projects</strong>
          <p class="text-[11px] text-amber-400">Unity Catalog, IREE, Recommenders</p>
        </button>
        <button
          type="button"
          onclick="window.filterToolsTier && window.filterToolsTier('mcp')"
          class="text-left p-3 rounded-xl border border-slate-800 bg-slate-900/50 hover:border-teal-500/50 hover:bg-slate-900 transition cursor-pointer group"
        >
          <span class="text-slate-400 block font-medium group-hover:text-teal-400 transition">MCP &amp; Tools</span>
          <strong class="text-white text-base font-bold">3,780+ Items</strong>
          <p class="text-[11px] text-teal-400">14 Technical Categories</p>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Featured LF AI & Data Foundation Technologies (Instant Server-Rendered Showcase) -->
<section class="max-w-7xl mx-auto px-4 pt-12 pb-6 sm:px-6 lg:px-8">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
    <div>
      <span class="kube-kicker">Core Foundation Infrastructure</span>
      <h2 class="text-3xl font-black tracking-tight text-white mt-1">
        Featured Hosted Technologies
      </h2>
    </div>
    <p class="text-sm text-slate-300 max-w-md">
      Production-tested foundation technologies governing model formats, vector indexing, feature storage, and orchestration runtimes.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <%= for proj <- Enum.take(@graduated_projects, 3) ++ Enum.take(@incubating_projects, 3) do %>
      <article class="p-6 rounded-2xl border border-slate-800 bg-slate-900/90 shadow-xs hover:border-emerald-500/50 hover:shadow-lg hover:shadow-emerald-950/20 transition-all flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between gap-2 mb-4">
            <div class="flex items-center gap-2">
              <%= if proj["maturity"] == "graduated" do %>
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Graduated
                </span>
              <% else %>
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-sky-500/15 text-sky-400 border border-sky-500/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span> Incubating
                </span>
              <% end %>
              <span class="text-xs text-slate-400 font-medium">{proj["category"]}</span>
            </div>
            <%= if proj["stars"] > 0 do %>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-bold text-amber-400 bg-amber-950/40 border border-amber-800/40 font-mono">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                {if proj["stars"] >= 1000,
                  do: "#{Float.round(proj["stars"] / 1000, 1)}k",
                  else: proj["stars"]}
              </span>
            <% end %>
          </div>

          <div class="flex items-center gap-3.5 mb-2">
            <%= if proj["logo"] do %>
              <div class="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700/80 p-1.5 flex items-center justify-center shrink-0 shadow-xs">
                <img
                  src={proj["logo"]}
                  alt={proj["name"]}
                  class="w-full h-full object-contain"
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              </div>
            <% end %>
            <div class="min-w-0 flex-1">
              <h3 class="text-xl font-bold text-white group-hover:text-emerald-400 transition-colors">
                <a
                  href={proj["website"] || proj["repo"]}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {proj["name"]}
                </a>
              </h3>
              <span class="text-xs text-slate-400 font-mono block">{proj["subcategory"]}</span>
            </div>
          </div>

          <p class="text-sm text-slate-300 mt-2 line-clamp-2 leading-relaxed">
            {proj["description"]}
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800 flex items-center justify-between text-xs">
          <span class="text-slate-400 font-mono">LF AI &amp; Data</span>
          <a
            href={proj["repo"] || proj["website"]}
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-emerald-400 hover:underline inline-flex items-center gap-1"
          >
            GitHub Repo &rarr;
          </a>
        </div>
      </article>
    <% end %>
  </div>
</section>

<!-- Tools Directory Section -->
<section class="max-w-7xl mx-auto px-4 py-12 sm:px-6 lg:px-8 border-t border-slate-800/80 mt-12">
  <div class="kube-tools-directory-heading flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
    <div>
      <span class="kube-kicker">Interactive CNCF-Style Landscape</span>
      <h2 class="text-3xl font-black tracking-tight text-white mt-1">
        Projects &amp; Ecosystem Directory
      </h2>
    </div>
    <p class="text-sm text-slate-300 max-w-md">
      Live filter across 3,780+ open AI technologies, Model Context Protocol (MCP) servers, vector databases, and security tools.
    </p>
  </div>

  <div id="kube-tools" class="min-h-[400px]">
    <div class="py-20 text-center text-slate-500">
      <div class="inline-block w-8 h-8 border-4 border-emerald-500 border-t-transparent rounded-full animate-spin mb-4">
      </div>
      <p class="text-sm font-medium text-slate-400">Loading AI tools directory...</p>
    </div>
  </div>

  <noscript>
    <div class="p-8 rounded-2xl border border-amber-800/80 bg-amber-950/40 text-amber-200">
      <h3 class="font-bold text-lg mb-2">JavaScript Required for Interactive Filtering</h3>
      <p>
        Please enable JavaScript to search and filter the live tools directory, or view our <a
          href="https://github.com/aidatafoundation/aidatafoundation.github.io"
          class="underline font-semibold"
        >tool entries directly on GitHub</a>.
      </p>
    </div>
  </noscript>

  <script type="module" src="/aidatafoundation/tools.js">
  </script>
</section>

<!-- Contribution Section for AI Data Foundation & Inference Collective -->
<section class="border-t border-slate-800 bg-[#070A0F] py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="p-8 sm:p-12 rounded-2xl border border-slate-800 bg-slate-900/90 flex flex-col md:flex-row items-center justify-between gap-8 shadow-xs">
      <div class="space-y-2 max-w-2xl">
        <span class="kube-kicker">Expand the Ecosystem</span>
        <h3 class="text-2xl font-bold text-white">
          Know an open AI tool that should be listed?
        </h3>
        <p class="text-sm text-slate-300 leading-relaxed">
          AI Data Foundation and Inference Collective curate community tools. Submit a pull request to add your open-source model, MCP server, embedding pipeline, or evaluation benchmark to the foundation directory.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href="https://github.com/aidatafoundation/aidatafoundation.github.io/blob/main/CONTRIBUTING.md"
          target="_blank"
          rel="noopener noreferrer"
          class="kube-button text-sm"
        >
          Contribution Guide &rarr;
        </a>
        <a
          href="https://github.com/aidatafoundation/aidatafoundation.github.io/issues/new"
          target="_blank"
          rel="noopener noreferrer"
          class="kube-button kube-button-outline text-sm border-slate-700 text-slate-200 hover:border-slate-600"
        >
          Recommend a Tool &nearr;
        </a>
      </div>
    </div>
  </div>
</section>
