<!DOCTYPE html>
<html lang="en" class="dark" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <title>{assigns[:page_title] || "AI Data Foundation · Secure AI & Open Data"}</title>
    <meta
      name="description"
      content="AI Data Foundation: secure AI engineering, open-source security tools, benchmarks, and hands-on labs for production-grade LLM systems and data governance."
    />
    <meta
      name="keywords"
      content="AI Data Security, AI Data Foundation, LLM Security, Prompt Injection, Model Watermarking, Red-Teaming, AI Governance, Open Source AI Security, Data Provenance"
    />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href="https://aidatafoundation.github.io/" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="AI Data Foundation Blog"
      href="/rss.xml"
    />

    <!-- OpenGraph & Twitter -->
    <meta property="og:site_name" content="AI Data Foundation" />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content={assigns[:page_title] || "AI Data Foundation · Open Tools, Benchmarks & Labs"}
    />
    <meta
      property="og:description"
      content="Open-source tools, model benchmarks, and hands-on labs for AI researchers and engineers."
    />
    <meta property="og:url" content="https://aidatafoundation.github.io/" />
    <meta property="og:image" content="/aidatafoundation/logos/aidatafoundation-dark.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={assigns[:page_title] || "AI Data Foundation"} />
    <meta
      name="twitter:description"
      content="Open-source tools, model benchmarks, and hands-on labs for AI researchers and engineers."
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-[#070A0F] text-slate-100 transition-colors duration-200 flex flex-col min-h-screen antialiased selection:bg-emerald-500/20 selection:text-emerald-300">
    <a href="#main-content" class="kube-skip-link">Skip to content</a>
    <!-- Reading Progress Pickup Banner -->
    <div id="pick-up" class="hidden">
      <span>Resume previous session:</span>
      <a href="#">Continue reading &rarr;</a>
      <button type="button" aria-label="Dismiss reading resume banner">&times;</button>
    </div>
    <!-- Standard AI Data Foundation Header -->
    <header class="kube-site-header sticky top-0 z-50 backdrop-blur-xl bg-[#070A0F]/90 border-b border-slate-800/80 transition-colors">
      <div class="kube-header-inner max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 sm:py-3 flex items-center justify-between gap-3">
        <!-- Brand Logo -->
        <a
          href="/"
          class="kube-brand flex items-center gap-2.5 sm:gap-3 group shrink-0"
          aria-label="Inference Collective Home"
        >
          <img
            src="/aidatafoundation/logos/aidatafoundation-dark.svg"
            alt="Inference Collective"
            width="160"
            height="48"
            class="h-8 sm:h-9 md:h-10 w-auto transition-transform duration-200 group-hover:scale-[1.02]"
          />
        </a>

        <!-- Desktop Navigation Bar (hidden lg:flex) -->
        <nav
          class="kube-nav-menu hidden lg:flex items-center gap-1 p-1 rounded-full bg-slate-900/80 border border-slate-800 shadow-xs"
          aria-label="Main Navigation"
        >
          <a
            href="/"
            class="kube-nav-link px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-emerald-400 hover:bg-slate-800 transition-all"
          >Home</a>
          <a
            href="/tools"
            class="kube-nav-link px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-emerald-400 hover:bg-slate-800 transition-all"
          >Tools</a>
          <a
            href="/models"
            class="kube-nav-link px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-emerald-400 hover:bg-slate-800 transition-all"
          >Models &amp; VRAM</a>
          <a
            href="/labs"
            class="kube-nav-link px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-emerald-400 hover:bg-slate-800 transition-all"
          >Labs</a>
          <a
            href="/blog"
            class="kube-nav-link px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-emerald-400 hover:bg-slate-800 transition-all"
          >Blog</a>
          <a
            href="/roadmap"
            class="kube-nav-link px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-emerald-400 hover:bg-slate-800 transition-all"
          >Roadmap</a>
          <a
            href="/security"
            class="kube-nav-link px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-emerald-400 hover:bg-slate-800 transition-all"
          >Security</a>
          <a
            href="/about"
            class="kube-nav-link px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-emerald-400 hover:bg-slate-800 transition-all"
          >About</a>
        </nav>

        <!-- Right Action Controls -->
        <div class="flex items-center gap-1.5 sm:gap-2.5">
          <!-- Theme Toggle -->
          <button
            type="button"
            id="theme-toggle"
            aria-label="Toggle Dark Mode"
            class="p-2 rounded-xl text-slate-300 hover:text-white bg-slate-900/80 hover:bg-slate-800 border border-slate-800 transition cursor-pointer"
          >
            <svg
              id="theme-sun"
              class="w-4 h-4 hidden [data-theme=dark]:block"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
              />
            </svg>
            <svg
              id="theme-moon"
              class="w-4 h-4 block [data-theme=dark]:hidden"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
              />
            </svg>
          </button>

          <!-- GitHub Link -->
          <a
            href="https://github.com/inferencecollective"
            target="_blank"
            rel="noopener noreferrer"
            class="kube-header-github inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-xl bg-slate-900 text-white dark:bg-slate-800 dark:hover:bg-slate-700 hover:bg-slate-800 text-xs font-semibold shadow-xs transition-all border border-slate-700/50"
            aria-label="GitHub Repository"
          >
            <svg class="w-4 h-4 fill-current shrink-0 inline-block" viewBox="0 0 24 24">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              />
            </svg>
            <span class="hidden sm:inline">GitHub</span>
          </a>

          <!-- Mobile Hamburger Toggle Button (lg:hidden) -->
          <button
            type="button"
            id="mobile-nav-toggle"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="mobile-nav-menu"
            class="lg:hidden p-2 rounded-xl text-slate-300 hover:text-white bg-slate-900/80 hover:bg-slate-800 border border-slate-800 transition cursor-pointer flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
          >
            <!-- Hamburger Icon (bars) -->
            <svg
              id="mobile-nav-icon-open"
              class="w-5 h-5 block"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"
              />
            </svg>
            <!-- Close Icon (X) -->
            <svg
              id="mobile-nav-icon-close"
              class="w-5 h-5 hidden"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>
      </div>
    </header>
    <!-- Backdrop Overlay for Mobile Drawer -->
    <div
      id="mobile-nav-overlay"
      class="hidden fixed inset-0 z-40 bg-black/75 backdrop-blur-sm transition-opacity lg:hidden"
      aria-hidden="true"
    >
    </div>

    <!-- Mobile Navigation Drawer Panel (lg:hidden) -->
    <div
      id="mobile-nav-menu"
      role="dialog"
      aria-modal="true"
      class="hidden fixed top-[53px] sm:top-[61px] inset-x-0 bottom-0 z-50 bg-[#070A0F]/98 backdrop-blur-2xl border-t border-slate-800/80 overflow-y-auto px-4 py-5 flex flex-col justify-between lg:hidden shadow-2xl transition-all"
      aria-label="Mobile Navigation"
    >
      <div class="space-y-4 max-w-md mx-auto w-full">
        <!-- Header Badge inside drawer -->
        <div class="flex items-center justify-between px-1 pb-2 border-b border-slate-800/60">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Navigation</span>
          <span class="inline-flex items-center gap-1.5 text-[11px] font-medium text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            All Catalogs Operational
          </span>
        </div>

        <!-- Links Grid/List -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <!-- Home -->
          <a
            href="/"
            class="kube-nav-link group flex items-center justify-between p-3 rounded-xl bg-slate-900/60 hover:bg-slate-800/80 border border-slate-800/80 transition-all text-left"
          >
            <div class="flex items-center gap-3">
              <span class="mobile-nav-icon-box p-2 rounded-lg bg-emerald-500/10 text-emerald-400 group-hover:bg-emerald-500/20 transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                  />
                </svg>
              </span>
              <div>
                <div class="text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">
                  Home
                </div>
                <div class="text-[11px] text-slate-400">Foundation Overview</div>
              </div>
            </div>
            <svg
              class="w-4 h-4 text-slate-500 group-hover:text-emerald-400 transition-colors"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </a>

          <!-- Tools -->
          <a
            href="/tools"
            class="kube-nav-link group flex items-center justify-between p-3 rounded-xl bg-slate-900/60 hover:bg-slate-800/80 border border-slate-800/80 transition-all text-left"
          >
            <div class="flex items-center gap-3">
              <span class="mobile-nav-icon-box p-2 rounded-lg bg-emerald-500/10 text-emerald-400 group-hover:bg-emerald-500/20 transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"
                  />
                </svg>
              </span>
              <div>
                <div class="text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">
                  Tools &amp; Ecosystem
                </div>
                <div class="text-[11px] text-slate-400">70+ Hosted AI Projects</div>
              </div>
            </div>
            <span class="text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded-full border border-emerald-500/20">70+</span>
          </a>

          <!-- Models & VRAM -->
          <a
            href="/models"
            class="kube-nav-link group flex items-center justify-between p-3 rounded-xl bg-slate-900/60 hover:bg-slate-800/80 border border-slate-800/80 transition-all text-left"
          >
            <div class="flex items-center gap-3">
              <span class="mobile-nav-icon-box p-2 rounded-lg bg-emerald-500/10 text-emerald-400 group-hover:bg-emerald-500/20 transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"
                  />
                </svg>
              </span>
              <div>
                <div class="text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">
                  Models &amp; VRAM
                </div>
                <div class="text-[11px] text-slate-400">Benchmarks &amp; Calculators</div>
              </div>
            </div>
            <span class="text-[10px] font-semibold bg-blue-500/10 text-blue-400 px-2 py-0.5 rounded-full border border-blue-500/20">VRAM</span>
          </a>

          <!-- Labs -->
          <a
            href="/labs"
            class="kube-nav-link group flex items-center justify-between p-3 rounded-xl bg-slate-900/60 hover:bg-slate-800/80 border border-slate-800/80 transition-all text-left"
          >
            <div class="flex items-center gap-3">
              <span class="mobile-nav-icon-box p-2 rounded-lg bg-emerald-500/10 text-emerald-400 group-hover:bg-emerald-500/20 transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
                  />
                </svg>
              </span>
              <div>
                <div class="text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">
                  Labs
                </div>
                <div class="text-[11px] text-slate-400">Interactive Runbooks</div>
              </div>
            </div>
            <span class="text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded-full border border-emerald-500/20">5 Labs</span>
          </a>

          <!-- Blog -->
          <a
            href="/blog"
            class="kube-nav-link group flex items-center justify-between p-3 rounded-xl bg-slate-900/60 hover:bg-slate-800/80 border border-slate-800/80 transition-all text-left"
          >
            <div class="flex items-center gap-3">
              <span class="mobile-nav-icon-box p-2 rounded-lg bg-emerald-500/10 text-emerald-400 group-hover:bg-emerald-500/20 transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
                  />
                </svg>
              </span>
              <div>
                <div class="text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">
                  Blog
                </div>
                <div class="text-[11px] text-slate-400">Engineering &amp; Research</div>
              </div>
            </div>
            <svg
              class="w-4 h-4 text-slate-500 group-hover:text-emerald-400 transition-colors"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </a>

          <!-- Roadmap -->
          <a
            href="/roadmap"
            class="kube-nav-link group flex items-center justify-between p-3 rounded-xl bg-slate-900/60 hover:bg-slate-800/80 border border-slate-800/80 transition-all text-left"
          >
            <div class="flex items-center gap-3">
              <span class="mobile-nav-icon-box p-2 rounded-lg bg-emerald-500/10 text-emerald-400 group-hover:bg-emerald-500/20 transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                  />
                </svg>
              </span>
              <div>
                <div class="text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">
                  Roadmap
                </div>
                <div class="text-[11px] text-slate-400">Milestones &amp; RFCs</div>
              </div>
            </div>
            <svg
              class="w-4 h-4 text-slate-500 group-hover:text-emerald-400 transition-colors"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </a>

          <!-- Security -->
          <a
            href="/security"
            class="kube-nav-link group flex items-center justify-between p-3 rounded-xl bg-slate-900/60 hover:bg-slate-800/80 border border-slate-800/80 transition-all text-left"
          >
            <div class="flex items-center gap-3">
              <span class="mobile-nav-icon-box p-2 rounded-lg bg-emerald-500/10 text-emerald-400 group-hover:bg-emerald-500/20 transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  />
                </svg>
              </span>
              <div>
                <div class="text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">
                  Security
                </div>
                <div class="text-[11px] text-slate-400">Threat Matrix &amp; Audits</div>
              </div>
            </div>
            <span class="text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded-full border border-emerald-500/20">Shield</span>
          </a>

          <!-- About -->
          <a
            href="/about"
            class="kube-nav-link group flex items-center justify-between p-3 rounded-xl bg-slate-900/60 hover:bg-slate-800/80 border border-slate-800/80 transition-all text-left"
          >
            <div class="flex items-center gap-3">
              <span class="mobile-nav-icon-box p-2 rounded-lg bg-emerald-500/10 text-emerald-400 group-hover:bg-emerald-500/20 transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
              </span>
              <div>
                <div class="text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">
                  About
                </div>
                <div class="text-[11px] text-slate-400">Charter &amp; Governance</div>
              </div>
            </div>
            <svg
              class="w-4 h-4 text-slate-500 group-hover:text-emerald-400 transition-colors"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </a>
        </div>

        <!-- Bottom Actions inside drawer -->
        <div class="pt-4 mt-2 border-t border-slate-800/80 space-y-3">
          <a
            href="https://github.com/inferencecollective"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2.5 w-full py-2.5 px-4 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-white text-xs font-semibold border border-slate-700/60 shadow-xs transition"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              />
            </svg>
            <span>View Organization on GitHub</span>
          </a>
          <div class="text-center text-[11px] text-slate-400">
            Inference Collective · Open Community AI Tooling
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <main
      id="main-content"
      tabindex="-1"
      class={["flex-1", @conn.request_path == "/" && "kube-home"]}
    >
      {@inner_content}
    </main>

    <!-- Standard AI Data Foundation Footer -->
    <footer class="kube-footer border-t border-slate-800/80 bg-[#070A0F] text-slate-400 py-16 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
          <!-- Foundation Brand & Identity -->
          <div class="lg:col-span-5 space-y-4 pr-0 lg:pr-8">
            <a
              href="/"
              class="kube-brand inline-flex items-center gap-3 group"
              aria-label="Inference Collective Home"
            >
              <img
                src="/aidatafoundation/logos/aidatafoundation-dark.svg"
                alt="Inference Collective"
                width="160"
                height="48"
                class="h-9 w-auto transition-transform duration-200 group-hover:scale-[1.02]"
              />
            </a>
            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-md">
              The independent, open-source foundation curating, standardizing, and verifying developer tooling, reproducible model benchmarks, datasets, and architectures for production AI systems.
            </p>

            <!-- System Status Pill -->
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span>All Catalogs &amp; Registries Operational</span>
            </div>

            <!-- Social / Inference Collective Badges -->
            <div class="pt-2 flex flex-wrap items-center gap-3 text-xs font-semibold">
              <a
                href="https://github.com/inferencecollective"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800/90 text-slate-700 dark:text-slate-200 hover:text-emerald-600 dark:hover:text-emerald-400 border border-slate-200 dark:border-slate-700 shadow-2xs hover:border-emerald-500/30 transition-all"
              >
                <svg class="w-4 h-4 fill-current text-emerald-500" viewBox="0 0 24 24">
                  <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  />
                </svg>
                <span>Inference Collective</span>
              </a>
              <a
                href="https://github.com/inferencecollective/inferencecollective.github.io"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800/90 text-slate-700 dark:text-slate-200 hover:text-emerald-600 dark:hover:text-emerald-400 border border-slate-200 dark:border-slate-700 shadow-2xs hover:border-emerald-500/30 transition-all"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  />
                </svg>
                <span>GitHub</span>
              </a>
              <a
                href="/about"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800/90 text-slate-700 dark:text-slate-200 hover:text-emerald-600 dark:hover:text-emerald-400 border border-slate-200 dark:border-slate-700 shadow-2xs hover:border-emerald-500/30 transition-all"
              >
                <span>About ADF</span>
              </a>
              <a
                href="/rss.xml"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800/90 text-slate-700 dark:text-slate-200 hover:text-emerald-600 dark:hover:text-emerald-400 border border-slate-200 dark:border-slate-700 shadow-2xs hover:border-emerald-500/30 transition-all"
              >
                <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z" /></svg>
                <span>RSS</span>
              </a>
            </div>
          </div>

          <!-- Catalogs & Tools -->
          <nav
            class="lg:col-span-2 space-y-3 flex flex-col text-sm"
            aria-label="Ecosystem & Tools"
          >
            <span class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">Catalogs &amp; Tools</span>
            <div class="flex flex-col space-y-2 pt-1">
              <a
                href="/tools"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >AI &amp; LLM Tools Directory</a>
              <a
                href="/models"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Models &amp; VRAM Calculator</a>
              <a
                href="/models#models-table"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Open Weights Leaderboard</a>
              <a
                href="/tools?category=MCP"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >MCP Servers &amp; Runtimes</a>
              <a
                href="/tools?category=Security"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >AI Security Tools</a>
            </div>
          </nav>

          <!-- Learning & Labs -->
          <nav class="lg:col-span-3 space-y-3 flex flex-col text-sm" aria-label="Learning & Labs">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">Hands-on Labs</span>
            <div class="flex flex-col space-y-2 pt-1">
              <a
                href="/labs"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Engineering Labs</a>
              <a
                href="/labs/LangChain-Practical-Labs"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >LangChain Practical Lab</a>
              <a
                href="/labs/AI-native-database"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Weaviate Vector DB Lab</a>
              <a
                href="/labs/prompt-injection-defense"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Prompt Injection Defense</a>
              <a
                href="/labs/automated-red-teaming"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Automated Red-Teaming</a>
              <a
                href="/roadmap"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >1,000-Step AI Roadmap</a>
            </div>
          </nav>

          <!-- Foundation & Governance -->
          <nav
            class="lg:col-span-2 space-y-3 flex flex-col text-sm"
            aria-label="Foundation & Governance"
          >
            <span class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">Foundation</span>
            <div class="flex flex-col space-y-2 pt-1">
              <a
                href="https://github.com/inferencecollective"
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Inference Collective</a>
              <a
                href="/blog"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Engineering Blog &amp; Notes</a>
              <a
                href="/about"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >About Foundation</a>
              <a
                href="/security"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >AI Safety &amp; Data Security</a>
              <a
                href="https://github.com/inferencecollective/inferencecollective.github.io/blob/main/CONTRIBUTING.md"
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Contribution Guidelines</a>
              <a
                href="https://github.com/inferencecollective/inferencecollective.github.io/issues"
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Report an Issue</a>
              <a
                href="/sitemap.xml"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Sitemap XML</a>
            </div>
          </nav>
        </div>

        <!-- Bottom Divider & Copyright Strip -->
        <div class="mt-14 pt-8 border-t border-slate-200/80 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-500">
          <p>
            &copy; {Date.utc_today().year} AI Data Foundation. Open source software released under the Apache-2.0 License.
          </p>
          <div class="flex flex-wrap items-center gap-3 font-medium text-slate-600 dark:text-slate-400">
            <span>Open Tools</span>
            <span class="text-slate-300 dark:text-slate-700">&bull;</span>
            <span>Open Models</span>
            <span class="text-slate-300 dark:text-slate-700">&bull;</span>
            <span>Open Benchmarks</span>
            <span class="text-slate-300 dark:text-slate-700">&bull;</span>
            <span class="px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-[10px] font-mono font-semibold">v2.4 LTS</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
