<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <title>{assigns[:page_title] || "AI Data Foundation · Secure AI & Open Data"}</title>
    <meta
      name="description"
      content="AI Data Foundation: secure AI engineering, open-source security tools, benchmarks, and hands-on labs for production-grade LLM systems and data governance."
    />
    <meta
      name="keywords"
      content="AI Data Security, AI Data Foundation, LLM Security, Prompt Injection, Model Watermarking, Red-Teaming, AI Governance, Open Source AI Security, Data Provenance"
    />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href="https://aidatafoundation.github.io/" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="AI Data Foundation Blog"
      href="/rss.xml"
    />

    <!-- OpenGraph & Twitter -->
    <meta property="og:site_name" content="AI Data Foundation" />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content={assigns[:page_title] || "AI Data Foundation · Open Tools, Benchmarks & Labs"}
    />
    <meta
      property="og:description"
      content="Open-source tools, model benchmarks, and hands-on labs for AI researchers and engineers."
    />
    <meta property="og:url" content="https://aidatafoundation.github.io/" />
    <meta property="og:image" content="/aidatafoundation/logos/aidatafoundation.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={assigns[:page_title] || "AI Data Foundation"} />
    <meta
      name="twitter:description"
      content="Open-source tools, model benchmarks, and hands-on labs for AI researchers and engineers."
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-[#FAFAFB] text-slate-900 transition-colors duration-200 [data-theme=dark]:bg-[#0B0F17] [data-theme=dark]:text-slate-100 flex flex-col min-h-screen antialiased selection:bg-emerald-500/20 selection:text-emerald-700 dark:selection:text-emerald-300">
    <!-- Reading Progress Pickup Banner -->
    <div id="pick-up" class="hidden">
      <span>Resume previous session:</span>
      <a href="#">Continue reading &rarr;</a>
      <button type="button" aria-label="Dismiss reading resume banner">&times;</button>
    </div>
    <div id="pick-up-phone" class="kube-phone-pickup">
      <p>Pick up where you left off?</p>
      <a href="#">Resume reading</a>
      <button type="button" aria-label="Dismiss">&times;</button>
    </div>
    <div id="pick-up-overlay" class="kube-pickup-overlay"></div>

    <!-- Standard AI Data Foundation Header -->
    <header class="kube-site-header sticky top-0 z-50 backdrop-blur-xl bg-white/80 dark:bg-[#0B0F17]/85 border-b border-slate-200/80 dark:border-slate-800/80 transition-colors">
      <div class="kube-header-inner max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between gap-4">
        <a
          href="/"
          class="kube-brand flex items-center gap-3 group"
          aria-label="AI Data Foundation Home"
        >
          <img
            src="/aidatafoundation/logos/aidatafoundation.svg"
            alt="AI Data Foundation"
            width="240"
            height="42"
            class="h-9 sm:h-10 w-auto transition-transform duration-200 group-hover:scale-[1.02] dark:hidden"
          />
          <img
            src="/aidatafoundation/logos/aidatafoundation-dark.svg"
            alt="AI Data Foundation"
            width="240"
            height="42"
            class="h-9 sm:h-10 w-auto transition-transform duration-200 group-hover:scale-[1.02] hidden dark:block"
          />
        </a>

        <nav
          class="kube-nav-menu hidden md:flex items-center gap-1 p-1 rounded-full bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800 shadow-xs"
          aria-label="Main Navigation"
        >
          <a
            href="/"
            class="kube-nav-link px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-white dark:hover:bg-slate-800 transition-all"
          >Home</a>
          <a
            href="/tools"
            class="kube-nav-link px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-white dark:hover:bg-slate-800 transition-all"
          >Tools</a>
          <a
            href="/models"
            class="kube-nav-link px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-white dark:hover:bg-slate-800 transition-all"
          >Models &amp; VRAM</a>
          <a
            href="/labs"
            class="kube-nav-link px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-white dark:hover:bg-slate-800 transition-all"
          >Labs</a>
          <a
            href="/blog"
            class="kube-nav-link px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-white dark:hover:bg-slate-800 transition-all"
          >Blog</a>
          <a
            href="/roadmap"
            class="kube-nav-link px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-white dark:hover:bg-slate-800 transition-all"
          >Roadmap</a>
          <a
            href="/security"
            class="kube-nav-link px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-white dark:hover:bg-slate-800 transition-all"
          >Security</a>
          <a
            href="/about"
            class="kube-nav-link px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-white dark:hover:bg-slate-800 transition-all"
          >About</a>
        </nav>

        <div class="flex items-center gap-2 sm:gap-3">
          <button
            type="button"
            id="theme-toggle"
            aria-label="Toggle Dark Mode"
            class="p-2 rounded-xl text-slate-500 hover:text-slate-900 hover:bg-slate-100 dark:text-slate-400 dark:hover:text-white dark:hover:bg-slate-800 border border-transparent hover:border-slate-200 dark:hover:border-slate-700 transition cursor-pointer"
          >
            <svg
              id="theme-sun"
              class="w-4 h-4 hidden [data-theme=dark]:block"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
              />
            </svg>
            <svg
              id="theme-moon"
              class="w-4 h-4 block [data-theme=dark]:hidden"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
              />
            </svg>
          </button>

          <a
            href="https://github.com/aidatafoundation/aidatafoundation.github.io"
            target="_blank"
            rel="noopener noreferrer"
            class="kube-header-github inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900 text-white dark:bg-slate-800 dark:hover:bg-slate-700 hover:bg-slate-800 text-xs font-semibold shadow-xs transition-all border border-slate-700/50"
          >
            <svg class="w-4 h-4 fill-current inline-block" viewBox="0 0 24 24">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              />
            </svg>
            <span class="hidden sm:inline">GitHub</span>
          </a>
        </div>
      </div>

      <!-- Mobile Navigation Drawer Strip -->
      <div class="md:hidden flex items-center gap-1 px-4 py-2 overflow-x-auto border-t border-slate-200/60 dark:border-slate-800/60 bg-slate-50/50 dark:bg-slate-900/50 text-xs font-medium text-slate-600 dark:text-slate-400">
        <a
          href="/"
          class="kube-nav-link whitespace-nowrap px-2.5 py-1 rounded-md hover:bg-white dark:hover:bg-slate-800"
        >Home</a>
        <a
          href="/tools"
          class="kube-nav-link whitespace-nowrap px-2.5 py-1 rounded-md hover:bg-white dark:hover:bg-slate-800"
        >Tools</a>
        <a
          href="/models"
          class="kube-nav-link whitespace-nowrap px-2.5 py-1 rounded-md hover:bg-white dark:hover:bg-slate-800"
        >Models &amp; VRAM</a>
        <a
          href="/labs"
          class="kube-nav-link whitespace-nowrap px-2.5 py-1 rounded-md hover:bg-white dark:hover:bg-slate-800"
        >Labs</a>
        <a
          href="/blog"
          class="kube-nav-link whitespace-nowrap px-2.5 py-1 rounded-md hover:bg-white dark:hover:bg-slate-800"
        >Blog</a>
        <a
          href="/roadmap"
          class="kube-nav-link whitespace-nowrap px-2.5 py-1 rounded-md hover:bg-white dark:hover:bg-slate-800"
        >Roadmap</a>
        <a
          href="/security"
          class="kube-nav-link whitespace-nowrap px-2.5 py-1 rounded-md hover:bg-white dark:hover:bg-slate-800"
        >Security</a>
        <a
          href="/about"
          class="kube-nav-link whitespace-nowrap px-2.5 py-1 rounded-md hover:bg-white dark:hover:bg-slate-800"
        >About</a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      {@inner_content}
    </main>

    <!-- Standard AI Data Foundation Footer -->
    <footer class="kube-footer border-t border-slate-200/90 dark:border-slate-800/80 bg-slate-50/80 dark:bg-[#070A0F] text-slate-600 dark:text-slate-400 py-16 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
          <!-- Foundation Brand & Identity -->
          <div class="lg:col-span-5 space-y-4 pr-0 lg:pr-8">
            <a
              href="/"
              class="kube-brand inline-flex items-center gap-3 group"
              aria-label="AI Data Foundation Home"
            >
              <img
                src="/aidatafoundation/logos/aidatafoundation.svg"
                alt="AI Data Foundation"
                width="240"
                height="42"
                class="h-9 w-auto dark:hidden transition-transform duration-200 group-hover:scale-[1.02]"
              />
              <img
                src="/aidatafoundation/logos/aidatafoundation-dark.svg"
                alt="AI Data Foundation"
                width="240"
                height="42"
                class="h-9 w-auto hidden dark:block transition-transform duration-200 group-hover:scale-[1.02]"
              />
            </a>
            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-md">
              The independent, open-source foundation curating, standardizing, and verifying developer tooling, reproducible model benchmarks, datasets, and architectures for production AI systems.
            </p>

            <!-- System Status Pill -->
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span>All Catalogs &amp; Registries Operational</span>
            </div>

            <!-- Social / Community Badges -->
            <div class="pt-2 flex flex-wrap items-center gap-3 text-xs font-semibold">
              <a
                href="https://github.com/aidatafoundation/aidatafoundation.github.io"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800/90 text-slate-700 dark:text-slate-200 hover:text-emerald-600 dark:hover:text-emerald-400 border border-slate-200 dark:border-slate-700 shadow-2xs hover:border-emerald-500/30 transition-all"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  />
                </svg>
                <span>GitHub</span>
              </a>
              <a
                href="/about"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800/90 text-slate-700 dark:text-slate-200 hover:text-emerald-600 dark:hover:text-emerald-400 border border-slate-200 dark:border-slate-700 shadow-2xs hover:border-emerald-500/30 transition-all"
              >
                <span>About ADF</span>
              </a>
              <a
                href="/rss.xml"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800/90 text-slate-700 dark:text-slate-200 hover:text-emerald-600 dark:hover:text-emerald-400 border border-slate-200 dark:border-slate-700 shadow-2xs hover:border-emerald-500/30 transition-all"
              >
                <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z" /></svg>
                <span>RSS</span>
              </a>
            </div>
          </div>

          <!-- Catalogs & Tools -->
          <nav
            class="lg:col-span-2 space-y-3 flex flex-col text-sm"
            aria-label="Ecosystem & Tools"
          >
            <span class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">Catalogs &amp; Tools</span>
            <div class="flex flex-col space-y-2 pt-1">
              <a
                href="/tools"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >AI &amp; LLM Tools Directory</a>
              <a
                href="/models"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Models &amp; VRAM Calculator</a>
              <a
                href="/models#models-table"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Open Weights Leaderboard</a>
              <a
                href="/tools?category=MCP"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >MCP Servers &amp; Runtimes</a>
              <a
                href="/tools?category=Security"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >AI Security Tools</a>
            </div>
          </nav>

          <!-- Learning & Labs -->
          <nav class="lg:col-span-3 space-y-3 flex flex-col text-sm" aria-label="Learning & Labs">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">Hands-on Labs</span>
            <div class="flex flex-col space-y-2 pt-1">
              <a
                href="/labs"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Engineering Labs</a>
              <a
                href="/labs/LangChain-Practical-Labs"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >LangChain Practical Lab</a>
              <a
                href="/labs/AI-native-database"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Weaviate Vector DB Lab</a>
              <a
                href="/labs/prompt-injection-defense"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Prompt Injection Defense</a>
              <a
                href="/labs/automated-red-teaming"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Automated Red-Teaming</a>
              <a
                href="/roadmap"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >1,000-Step AI Roadmap</a>
            </div>
          </nav>

          <!-- Foundation & Governance -->
          <nav
            class="lg:col-span-2 space-y-3 flex flex-col text-sm"
            aria-label="Foundation & Governance"
          >
            <span class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">Foundation</span>
            <div class="flex flex-col space-y-2 pt-1">
              <a
                href="/blog"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Engineering Blog &amp; Notes</a>
              <a
                href="/about"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >About Foundation</a>
              <a
                href="/security"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >AI Safety &amp; Data Security</a>
              <a
                href="https://github.com/aidatafoundation/aidatafoundation.github.io/blob/main/CONTRIBUTING.md"
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Contribution Guidelines</a>
              <a
                href="https://github.com/aidatafoundation/aidatafoundation.github.io/issues"
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Report an Issue</a>
              <a
                href="/sitemap.xml"
                class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >Sitemap XML</a>
            </div>
          </nav>
        </div>

        <!-- Bottom Divider & Copyright Strip -->
        <div class="mt-14 pt-8 border-t border-slate-200/80 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-500">
          <p>
            &copy; {Date.utc_today().year} AI Data Foundation. Open source software released under the Apache-2.0 License.
          </p>
          <div class="flex flex-wrap items-center gap-3 font-medium text-slate-600 dark:text-slate-400">
            <span>Open Tools</span>
            <span class="text-slate-300 dark:text-slate-700">&bull;</span>
            <span>Open Models</span>
            <span class="text-slate-300 dark:text-slate-700">&bull;</span>
            <span>Open Benchmarks</span>
            <span class="text-slate-300 dark:text-slate-700">&bull;</span>
            <span class="px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-[10px] font-mono font-semibold">v2.4 LTS</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
